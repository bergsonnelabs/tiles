  "config": {
    "gpio": {
      "kind": "boolean",
      "group": "Sidebands",
      "label": "Use GPIO sideband",
      "binding": {
        "pad": "3",
        "kind": "intent"
      },
      "default": false,
      "options": [
        {
          "value": false,
          "firmware_contract": [
            {
              "via": "i2c",
              "type": "register",
              "value": "input-floating",
              "register": "COMM.GPIODIR"
            }
          ]
        },
        {
          "value": true,
          "netlist": {
            "expects": [
              {
                "to": {
                  "kind": "matchFunction",
                  "function": "GPIO",
                  "capabilities": [
                    "input",
                    "output"
                  ]
                },
                "tag": "gpio.attached",
                "from": {
                  "pad": "3",
                  "kind": "tile"
                },
                "role": "data"
              }
            ]
          },
          "firmware_contract": [
            {
              "text": "Wire pad 3 to a Core GPIO. Used as the write-gate for GPIO-gated I2C re-addressing when two BOS1921 share one bus (both default 0x44): the Core holds the target chip's GPIO low while it re-addresses. Core drives the pad; the chip side is configured via COMM.GPIODIR.",
              "type": "note"
            }
          ]
        }
      ],
      "description": "Pad 3 is the BOS1921 GPIO, routed to a Core pad. Only needed to place two Drive.P on one I2C bus (GPIO-gated re-address, driver §6.3.3). Leave unused for a single Drive.P."
    },
    "interfaceMode": {
      "kind": "select",
      "group": "Interfaces",
      "label": "Interface mode",
      "default": "i2c",
      "options": [
        {
          "label": "I2C",
          "value": "i2c",
          "activates": {
            "interface": "I2C"
          }
        },
        {
          "label": "I3C",
          "value": "i3c",
          "activates": {
            "interface": "I3C"
          }
        }
      ],
      "description": "Selects which bus this tile sits on. The chip's mode is set by firmware via register write at init (no boot-strap pad on this tile), so the catalog choice expresses *wiring intent* and which interface's pad_assignments are active."
    }
  },

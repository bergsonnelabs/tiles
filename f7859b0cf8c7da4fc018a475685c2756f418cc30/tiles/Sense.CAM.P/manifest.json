{
  "schema": "studio-manifest/v1",
  "source": "tiles@e3a9c64",
  "tile": "Sense.CAM.P",
  "palette": {
    "label": "Sense.CAM.P",
    "icon": "◉"
  },
  "driver": {
    "prefix": "tile_sense_cam_p",
    "header": "tile_sense_cam_p.h",
    "version": "0.1.0"
  },
  "handle": {

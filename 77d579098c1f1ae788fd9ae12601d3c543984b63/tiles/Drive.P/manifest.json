  "hosts": [
    {
      "qname": [
        "$slot",
        "set_mode"
      ],
      "symbol": "tile_drive_p_set_mode",
      "header": "tile_drive_p.h",
      "category": "tile",
      "description": "Set the operating mode.",
      "params": [
        {
          "name": "mode",
          "type": "int",
          "description": "One of the drive_p_mode_t values",
          "choices": [
            {
              "name": "DRIVE_P_MODE_IDLE",
              "value": 0,
              "label": "Output disabled, status readback"
            },
            {
              "name": "DRIVE_P_MODE_SENSE_FINE",
              "value": 1,
              "label": "Piezo sensing, 7.6 mV/LSB resolution"
            },
            {
              "name": "DRIVE_P_MODE_SENSE_COARSE",
              "value": 2,
              "label": "Piezo sensing, 54.5 mV/LSB resolution"
            },
            {
              "name": "DRIVE_P_MODE_PLAY_DIRECT",
              "value": 3,
              "label": "Direct waveform output"
            },
            {
              "name": "DRIVE_P_MODE_PLAY_FIFO",
              "value": 4,
              "label": "FIFO-buffered playback, 8 ksps"
            },
            {
              "name": "DRIVE_P_MODE_PLAY_RAM_SYNTH",
              "value": 5,
              "label": "RAM Synthesis waveform playback"
            }
          ]
        }
      ],
      "returns": "void",
      "receiver": "tile_t*"
    },

/**
 * tile_handles.h — Tile driver includes and instance handles for {{ project_name }}
 *
 * Initially generated by coregen. The section between coregen markers
 * is kept in sync with config.json automatically — add your own
 * tile-related defines outside the markers.
 *
 * Named tile_handles.h (not tiles.h) so it doesn't shadow the
 * top-level tiles.h in the compiler include path.
 */

#ifndef TILE_HANDLES_H
#define TILE_HANDLES_H

/* ---- coregen:begin ---- */
#include "tiles.h"
#include "tiles_pal.h"
#include "core_tiles.h"
{% for header in tile_driver_headers %}
#include "{{ header }}"
{% endfor %}

/* Tile PAL handles (one per bus used by tiles) */
{% for bus in tile_pal_buses %}
tiles_pal_t {{ bus.pal_handle }};
{% endfor %}

/* Tile instance handles */
{% for tile in tiles_config %}
tile_t {{ tile.handle }};
{% endfor %}

/* Iterable tile table — bringup iterates this config data instead of hand-coding
 * per-variant init, so a new hardware variant is a config change, not a code fork.
 * `bus` is the raw bus handle: same pointer == same bus (group by it), and
 * core_tiles_pal((core_i2c_t*)bus) yields the PAL (core_spi_t* when
 * bus_is_spi, core_i3c_t* when bus_is_i3c). `readdress_gpio` is the Core
 * pad wired to a tile's address-strap (Drive.P), or -1. */
typedef struct {
    const char   *type;           /* tile type, e.g. "Drive.P" */
    void         *bus;            /* &core_i2cN / &core_spiN / &core_i3cN */
    unsigned char bus_is_spi;
    unsigned char instance;
    tile_t       *handle;
    signed char   readdress_gpio;
    unsigned char bus_is_i3c;     /* 1: an I2C bus coregen runs as I3C (Core.ST.H5) */
} core_tile_entry_t;

const core_tile_entry_t core_tile_table[] = {
{% for tile in tiles_config %}
    { "{{ tile.type }}", &{{ tile.bus_handle }}, {{ tile.bus_is_spi }}, {{ tile.instance }}, &{{ tile.handle }}, {{ tile.readdress_gpio }}, {{ tile.bus_is_i3c }} },
{% endfor %}
};
const unsigned char core_tile_count = sizeof(core_tile_table) / sizeof(core_tile_table[0]);
/* ---- coregen:end ---- */

#endif /* TILE_HANDLES_H */

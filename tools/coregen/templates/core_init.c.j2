void core_clock_init(void)
{
{% if mcu.define == "STM32L011xx" %}
    /* STM32L011, RM0377. Runs from reset (MSI 2.1 MHz, voltage range 2, 0 WS)
     * and again after every Stop (wakes on MSI at the range set here; the
     * voltage range is kept). Target: {{ clock_config.source }} {{ clock_config.sysclk_hz }} Hz,
     * voltage range {{ clock_config.vos_range }}, flash latency per Table 14. */
    ll_rcc_pwr_clk_enable();

    /* The PLL can only be reconfigured while it is off (§7.2.4). */
    if (((REG32(RCC_BASE + RCC_CFGR_OFFSET) >> RCC_CFGR_SWS_SHIFT) & 0x3UL) == LL_RCC_SYSCLK_PLL) {
        ll_rcc_hsi16_enable();
        while (!ll_rcc_hsi16_ready())
            ;
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI16);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI16);
        ll_rcc_pll_disable();
    }
{% if clock_config.source == "msi" %}
{% if clock_config.vos_range == 3 %}

    /* MSI first, then range 3 (clock down before range down, §6.1.7). Range 3:
     * <= 4.2 MHz at 0 WS, no HSI16, no flash/EEPROM writes (core_nvm raises
     * the range around an EEPROM write). */
    ll_rcc_msi_set_range({{ clock_config.msi_range }});
    while (!ll_rcc_msi_ready())
        ;
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_MSI);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_MSI);
    ll_flash_set_latency(ll_flash_latency_for_range({{ clock_config.sysclk_mhz_ceil }}, 3));
    ll_pwr_set_vos(3);
{% else %}

    /* Range {{ clock_config.vos_range }} first (range up before clock up, §6.1.7), then MSI. */
    ll_pwr_set_vos({{ clock_config.vos_range }});
    ll_rcc_msi_set_range({{ clock_config.msi_range }});
    while (!ll_rcc_msi_ready())
        ;
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_MSI);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_MSI);
    ll_flash_set_latency(ll_flash_latency_for_range({{ clock_config.sysclk_mhz_ceil }}, {{ clock_config.vos_range }}));
{% endif %}
{% if clock_config.hsi16_kernel %}

    /* I2C1's kernel clock is HSI16 (RCC_CCIPR.I2C1SEL, set in core_pads_init)
     * so 400 kHz works at this MSI level. Stop turns HSI16 off (HSI16KERON is
     * left clear, RM0377 §7.3.1), so it is started here, which runs again on
     * every wake. Costs ~100 µA while running (DS: IDD(HSI16)). */
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
{% endif %}
{% else %}

    /* Range 1 before the clock goes up (§6.1.7): up to 32 MHz, 0 WS <= 16 MHz. */
    ll_pwr_set_vos(1);
    {
        uint32_t ws = ll_flash_latency_for_range({{ clock_config.sysclk_mhz_ceil }}, 1);
        if (ll_flash_get_latency() < ws)
            ll_flash_set_latency(ws);

        /* Below VDD 2.0 V each SYSCLK step must be under 4x with 5 µs between
         * steps (§6.1.4; this Core runs from 1.8 V up): MSI 2.1 -> 4.2 MHz ->
         * HSI16{{ " -> PLL" if clock_config.pll else "" }}. */
        ll_rcc_msi_set_range(LL_RCC_MSI_RANGE_4MHZ);
        while (!ll_rcc_msi_ready())
            ;
        for (volatile uint32_t d = 0; d < 20u; d++)
            ;
        ll_rcc_hsi16_enable();
        while (!ll_rcc_hsi16_ready())
            ;
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI16);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI16);
{% if clock_config.pll %}
        for (volatile uint32_t d = 0; d < 20u; d++)
            ;

        /* PLL: 16 MHz x{{ clock_config.pll.n }} = VCO {{ 16 * clock_config.pll.n }} MHz (<= 96 in range 1, §7.2.4), /{{ clock_config.pll.r }} = {{ clock_config.sysclk_mhz }} MHz */
        ll_rcc_pll_config(LL_RCC_PLLSRC_HSI16, {{ clock_config.pll.m }}, {{ clock_config.pll.n }}, {{ clock_config.pll.r }});
        ll_rcc_pll_enable();
        while (!ll_rcc_pll_ready())
            ;
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_PLL);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_PLL);
{% endif %}
        ll_flash_set_latency(ws);
    }
{% endif %}

{% elif mcu.define == "STM32WBA55xx" %}
    /* STM32WBA55, RM0493. Runs from reset and again after every Stop 1; both
     * leave SYSCLK on HSI16 in voltage range 2 with 1 WS (flash and SRAM) and
     * hclk5 = SYSCLK / 2 (HDIV5). Target: {{ clock_config.source }} {{ clock_config.sysclk_mhz }} MHz in
     * range {{ clock_config.vos_range }}. */
    ll_rcc_pwr_clk_enable();

    /* PLL settings can only change while it is off (§12.4.3). */
    if (((REG32(RCC_BASE + RCC_CFGR_OFFSET) >> RCC_CFGR_SWS_SHIFT) & 0x3UL) == LL_RCC_SYSCLK_PLL) {
        ll_rcc_hsi16_enable();
        while (!ll_rcc_hsi16_ready())
            ;
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI16);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI16);
    }
{% if clock_config.vos_range == 2 %}

    /* HSI16 in range 2 (Table 99: SYSCLK <= 16 MHz, hclk5 <= 8 MHz). Order per
     * §12.4.6: HDIV5 set, switch to HSI16, then range 2. Flash 1 WS (Table 41:
     * range 2 has 0 WS only up to 8 MHz) and SRAM 1 WS (Table 36: 0 WS only up
     * to 12 MHz). The PLL must be off in range 2 (§12.4.3). */
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
    ll_rcc_set_hdiv5(1);
    {
        uint32_t ws = ll_flash_latency_for_range(16, 2);
        if (ll_flash_get_latency() < ws)
            ll_flash_set_latency(ws);
        SET_BITS(REG32(RCC_BASE + 0x088UL), 1UL << 17);  /* RCC_AHB1ENR.RAMCFGEN (§12.8.20): RAMCFG drops writes without it */
        (void)REG32(RCC_BASE + 0x088UL);
        if (!(REG32(0x40026000UL) & (0x7UL << 16)))   /* RAMCFG_M1CR.WSC, RM0493 §6.6.1 */
            MOD_BITS(REG32(0x40026000UL), 0x7UL << 16, 1UL << 16);
        if (!(REG32(0x40026040UL) & (0x7UL << 16)))   /* RAMCFG_M2CR.WSC, §6.6.4 */
            MOD_BITS(REG32(0x40026040UL), 0x7UL << 16, 1UL << 16);
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI16);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI16);
        if (ll_rcc_pll_ready())
            ll_rcc_pll_disable();
        ll_pwr_set_vos(2);
        ll_flash_set_latency(ws);
    }
{% else %}

    /* Range 1 before the clock goes up (§12.4.6): SYSCLK up to 100 MHz,
     * hclk5 up to 32 MHz. */
    ll_pwr_set_vos(1);
    ll_rcc_hse_enable();
    while (!ll_rcc_hse_ready())
        ;
    {
        uint32_t ws = ll_flash_latency_for_range({{ clock_config.sysclk_mhz }}, 1);
        if (ll_flash_get_latency() < ws)
            ll_flash_set_latency(ws);
{% if clock_config.pll %}

        /* PLL1: HSE 32 MHz /{{ clock_config.pll.m }} = {{ (32 / clock_config.pll.m) | round(1) }} MHz (4-16 MHz) x{{ clock_config.pll.n }} = VCO {{ (32 / clock_config.pll.m * clock_config.pll.n) | int }} MHz (128-544),
         * /{{ clock_config.pll.r }} = {{ clock_config.sysclk_mhz }} MHz. */
        if (ll_rcc_pll_ready())
            ll_rcc_pll_disable();
        ll_rcc_pll_config(LL_RCC_PLLSRC_HSE, {{ clock_config.pll.m }}, {{ clock_config.pll.n }}, {{ clock_config.pll.r }});
        ll_rcc_pll_enable();
        while (!ll_rcc_pll_ready())
            ;

        /* hclk5 = SYSCLK / {{ clock_config.hpre5 }} = {{ (clock_config.sysclk_mhz / clock_config.hpre5) | round(1) }} MHz (<= 32), written before the
         * switch (§12.4.6). The SYSCLK step from 16 MHz is more than 43 MHz
         * (Table 99), so the switch goes through the pll1rclk prescaler. */
        ll_rcc_set_hpre5({{ clock_config.hpre5 }});
        ll_rcc_pll1_rclkpre_divide();
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_PLL);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_PLL);
        ll_rcc_pll1_rclkpre_release();
{% else %}

        /* HSE32 direct: 16 -> 32 MHz is inside the 43 MHz step (Table 99). */
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSE);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSE);
        if (ll_rcc_pll_ready())
            ll_rcc_pll_disable();
{% endif %}
        ll_flash_set_latency(ws);
    }
    /* hclk5 undivided in range 1: {{ "HPRE5 sets it on the PLL; HDIV5 applies if SYSCLK falls back to HSE/HSI" if clock_config.pll else "32 MHz, the range 1 limit" }}.
     * The radio needs HDIV5 clear (§12.4.6). */
    ll_rcc_set_hdiv5(0);
{% endif %}

{% else %}
{% if clock_config.pll %}
{% if clock_config.needs_vos %}
    /* ---- Voltage scaling for high-speed operation ---- */
    ll_rcc_pwr_clk_enable();
    ll_pwr_set_vos({{ clock_config.vos_value }});
{% endif %}

    /* ---- Enable clock source: {{ clock_config.source }} ---- */
{% if clock_config.source in ("hsi16", "hsi") %}
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
{% elif clock_config.source == "hse" %}
    ll_rcc_hse_enable();
    while (!ll_rcc_hse_ready())
        ;
{% elif clock_config.source == "hsi48" %}
    ll_rcc_hsi48_enable();
    while (!ll_rcc_hsi48_ready())
        ;
{% endif %}

    /* ---- Flash wait states for {{ clock_config.sysclk_mhz }}MHz ---- */
    ll_flash_set_latency(ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }}));

    /* ---- Configure PLL: {{ clock_config.source_mhz }}MHz ÷{{ clock_config.pll.m }} ×{{ clock_config.pll.n }} ÷{{ clock_config.pll.r }} = {{ clock_config.sysclk_mhz }}MHz ---- */
{% if clock_config.source in ("hsi16", "hsi") %}
    ll_rcc_pll_config(LL_RCC_PLLSRC_HSI16, {{ clock_config.pll.m }}, {{ clock_config.pll.n }}, {{ clock_config.pll.r }});
{% elif clock_config.source == "hse" %}
    ll_rcc_pll_config(LL_RCC_PLLSRC_HSE, {{ clock_config.pll.m }}, {{ clock_config.pll.n }}, {{ clock_config.pll.r }});
{% elif clock_config.source == "hsi48" %}
    ll_rcc_pll_config(LL_RCC_PLLSRC_HSI48, {{ clock_config.pll.m }}, {{ clock_config.pll.n }}, {{ clock_config.pll.r }});
{% endif %}
    ll_rcc_pll_enable();
    while (!ll_rcc_pll_ready())
        ;

    /* ---- Switch SYSCLK to PLL ---- */
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_PLL);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_PLL);

{% else %}
    /* ---- No PLL — run directly from {{ clock_config.source }} at {{ clock_config.sysclk_mhz }}MHz ---- */
{% if clock_config.needs_vos %}
    /* ---- Voltage scaling for high-speed operation ---- */
    ll_rcc_pwr_clk_enable();
    ll_pwr_set_vos({{ clock_config.vos_value }});
{% endif %}
{% if clock_config.source in ("hsi16", "hsi") %}
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
    ll_flash_set_latency(ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }}));
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI16);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI16);
{% elif clock_config.source == "csi" %}
    /* CSI 4 MHz low-power internal RC (H5 only) */
    ll_rcc_csi_enable();
    while (!ll_rcc_csi_ready())
        ;
    ll_flash_set_latency(ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }}));
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_CSI);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_CSI);
{% elif clock_config.source == "hse" %}
    ll_rcc_hse_enable();
    while (!ll_rcc_hse_ready())
        ;
    ll_flash_set_latency(ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }}));
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSE);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSE);
{% elif clock_config.source == "msi" %}
    /* Configure MSI to {{ clock_config.sysclk_mhz }}MHz. SYSCLK is already MSI at reset, so a
     * range change is a clock change: raise the wait states BEFORE it and
     * lower them after (RM0394 §3.3.3). */
    {
        uint32_t ws = ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }});
        if (ll_flash_get_latency() < ws)
            ll_flash_set_latency(ws);
        ll_rcc_msi_set_range({{ clock_config.msi_range }});
        while (!ll_rcc_msi_ready())
            ;
        ll_rcc_set_sysclk(LL_RCC_SYSCLK_MSI);
        ll_rcc_wait_sysclk(LL_RCC_SYSCLK_MSI);
        ll_flash_set_latency(ws);
    }
{% elif clock_config.source == "hsi48" %}
    ll_rcc_hsi48_enable();
    while (!ll_rcc_hsi48_ready())
        ;
    ll_flash_set_latency(ll_flash_latency_for_mhz({{ clock_config.sysclk_mhz }}));
    ll_rcc_set_sysclk(LL_RCC_SYSCLK_HSI48);
    ll_rcc_wait_sysclk(LL_RCC_SYSCLK_HSI48);
{% endif %}
{% endif %}

{% endif %}
    /* ---- Bus prescalers ---- */
    ll_rcc_set_ahb_div({{ clock_config.ahb_div }});
    ll_rcc_set_apb1_div({{ clock_config.apb1_div }});
    ll_rcc_set_apb2_div({{ clock_config.apb2_div }});

    /* ---- SysTick (1ms tick for ll_delay_ms) ---- */
    ll_systick_init(SYSCLK_HZ);
{% if usb_enabled or usb_capable %}

    /* ---- USB 48MHz clock (HSI48, crystal-less via CRS) ---- */
    ll_rcc_hsi48_enable();
    while (!ll_rcc_hsi48_ready())
        ;
#if defined(STM32H523xx)
    ll_rcc_set_usb_clk_source(LL_RCC_USB_HSI48);
    ll_rcc_apb2_clk_enable(LL_APB2_USB);
#else
    ll_rcc_set_usb_clk_source(LL_RCC_USB48_HSI48);
    ll_rcc_apb1_clk_enable(LL_APB1_USB);
#endif
{% endif %}
}

void core_pads_init(void)
{
{% if pad_config %}
    /* Enable GPIO port clocks for all configured pads */
{% set enabled_ports = [] %}
{% for pin in pad_config %}
{% if pin.port and pin.port not in enabled_ports %}
{% if enabled_ports.append(pin.port) %}{% endif %}
    ll_rcc_gpio_clk_enable(GPIO{{ pin.port }});
{% endif %}
{% endfor %}

    /* Configure each assigned pad */
{% for pin in pad_config %}
{% if pin.mode == "output" %}
{% set speed_map = {"low": "LL_GPIO_SPEED_LOW", "medium": "LL_GPIO_SPEED_MED", "high": "LL_GPIO_SPEED_HIGH", "very-high": "LL_GPIO_SPEED_VHIGH"} %}
{% set speed_ll = speed_map.get(pin.speed, "LL_GPIO_SPEED_MED") %}
{% if pin.output_type == "open-drain" %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → GPIO output (open-drain{{ ", pull-%s" | format(pin.pull) if pin.pull != "none" else "" }}) */
    ll_gpio_set_mode(GPIO{{ pin.port }}, {{ pin.pin }}, LL_GPIO_MODE_OUTPUT);
    ll_gpio_set_output_type(GPIO{{ pin.port }}, {{ pin.pin }}, LL_GPIO_OTYPE_OD);
    ll_gpio_set_speed(GPIO{{ pin.port }}, {{ pin.pin }}, {{ speed_ll }});
    ll_gpio_set_pull(GPIO{{ pin.port }}, {{ pin.pin }}, {{ "LL_GPIO_PULL_UP" if pin.pull == "up" else ("LL_GPIO_PULL_DOWN" if pin.pull == "down" else "LL_GPIO_PULL_NONE") }});
{% elif pin.speed != "medium" %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → GPIO output (push-pull, {{ pin.speed }}) */
    ll_gpio_set_mode(GPIO{{ pin.port }}, {{ pin.pin }}, LL_GPIO_MODE_OUTPUT);
    ll_gpio_set_output_type(GPIO{{ pin.port }}, {{ pin.pin }}, LL_GPIO_OTYPE_PP);
    ll_gpio_set_speed(GPIO{{ pin.port }}, {{ pin.pin }}, {{ speed_ll }});
    ll_gpio_set_pull(GPIO{{ pin.port }}, {{ pin.pin }}, LL_GPIO_PULL_NONE);
{% else %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → GPIO output (push-pull) */
    ll_gpio_config_output(GPIO{{ pin.port }}, {{ pin.pin }});
{% endif %}
{% if pin.default == "high" %}
    ll_gpio_set(GPIO{{ pin.port }}, 1UL << {{ pin.pin }});
{% elif pin.default == "low" %}
    ll_gpio_clear(GPIO{{ pin.port }}, 1UL << {{ pin.pin }});
{% endif %}
{% elif pin.mode == "input" %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → GPIO input{{ " (pull-%s)" | format(pin.pull) if pin.pull != "none" else "" }} */
    ll_gpio_config_input(GPIO{{ pin.port }}, {{ pin.pin }}, {{ "LL_GPIO_PULL_UP" if pin.pull == "up" else ("LL_GPIO_PULL_DOWN" if pin.pull == "down" else "LL_GPIO_PULL_NONE") }});
{% elif pin.mode == "analog" %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → {{ pin.function }} (analog) */
    ll_gpio_config_analog(GPIO{{ pin.port }}, {{ pin.pin }});
{% elif pin.af is not none %}
    /* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → {{ pin.function }} (AF{{ pin.af }}) */
    ll_gpio_config_af(GPIO{{ pin.port }}, {{ pin.pin }}, {{ pin.af }},
{% if "I2C" in pin.function or "I3C" in pin.function %}
{% set bus_name = pin.function.split('.')[0] %}
                       LL_GPIO_OTYPE_OD, LL_GPIO_SPEED_VHIGH, {{ "LL_GPIO_PULL_UP" if i2c_pullups.get(bus_name, true) else "LL_GPIO_PULL_NONE" }});
{% else %}
                       LL_GPIO_OTYPE_PP, LL_GPIO_SPEED_VHIGH, LL_GPIO_PULL_NONE);
{% endif %}
{% endif %}
{% endfor %}
{% set exti_pads = pad_config | selectattr("exti") | list %}
{% if exti_pads %}

    /* ---- EXTI (external interrupt) init ---- */
{% for pin in exti_pads %}
    hal_exti_enable({{ pin.pad }}, {{ "HAL_EXTI_RISING" if pin.exti == "rising" else ("HAL_EXTI_FALLING" if pin.exti == "falling" else "HAL_EXTI_BOTH") }}, _studio_pad_edge_isr, (void *)(uintptr_t){{ pin.pad }});
{% endfor %}
{% endif %}
{% else %}
    /* No pads configured in config.json */
{% endif %}
{% if pullup_pins %}

    /* ---- On-tile pull-ups (config.json "pullups"): drive the control pins ---- */
{% for p in pullup_pins %}
    /* {{ p.label }}: P{{ p.port }}{{ p.pin }} {{ "high" if p.high else "low" }} */
    ll_rcc_gpio_clk_enable(GPIO{{ p.port }});
    ll_gpio_config_output(GPIO{{ p.port }}, {{ p.pin }});
    {{ "ll_gpio_set" if p.high else "ll_gpio_clear" }}(GPIO{{ p.port }}, 1UL << {{ p.pin }});
{% endfor %}
{% endif %}
{% if sai_kernel_clk == "hsi16" %}

    /* ---- SAI1 kernel clock: HSI16 (independent of SYSCLK) ---- */
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
    ll_rcc_set_sai_clk_source(LL_RCC_SAI_CLK_HSI16);
{% endif %}
{% if i2c_buses %}
{% if i2c_kernel_clk == "hsi16" %}

    /* ---- I2C kernel clock: HSI16 (independent of SYSCLK) ---- */
    ll_rcc_hsi16_enable();
    while (!ll_rcc_hsi16_ready())
        ;
{% for bus in i2c_buses %}
    ll_rcc_set_i2c_clk_source({{ bus.num }}, LL_RCC_I2C_CLK_HSI16);
{% endfor %}
{% endif %}

    /* ---- I2C peripheral init ---- */
{% for bus in i2c_buses %}
    {{ bus.clk_func }}({{ bus.clk_mask }});
    {
        hal_i2c_config_t _{{ bus.handle }}_cfg = { .timing = {{ bus.timing }}, .timeout_ms = 100 };
        hal_i2c_init(&{{ bus.handle }}, {{ bus.instance }}, &_{{ bus.handle }}_cfg);
    }
{% endfor %}
{% endif %}
{% if spi_buses %}

    /* ---- SPI peripheral init ---- */
{% for bus in spi_buses %}
    {{ bus.clk_func }}({{ bus.clk_mask }});
    {
        hal_spi_config_t _{{ bus.handle }}_cfg = { .prescaler = {{ bus.prescaler }}, .cpol = {{ bus.cpol }}, .cpha = {{ bus.cpha }}, .lsb_first = {{ 1 if bus.lsb_first else 0 }} };
        hal_spi_init(&{{ bus.handle }}, {{ bus.instance }}, &_{{ bus.handle }}_cfg);
{% if bus.cs_port %}
        /* Pad {{ bus.cs_pad }} is this bus's chip select: core_spi_select()/
         * deselect() and the tile bridge (core_tiles_pal) drive it. */
        {{ bus.handle }}.cs_active_low = {{ 1 if bus.cs_active_low else 0 }};
        hal_spi_set_cs(&{{ bus.handle }}, GPIO{{ bus.cs_port }}, {{ bus.cs_pin }});
{% endif %}
    }
{% endfor %}
{% endif %}
{% if usart_buses %}

    /* ---- USART peripheral init ---- */
{% for bus in usart_buses %}
    {{ bus.clk_func }}({{ bus.clk_mask }});
    {
        hal_uart_config_t _{{ bus.handle }}_cfg = { .baud = {{ bus.baud }}, .rx_interrupt = {{ bus.rx_interrupt }} };
        hal_uart_init(&{{ bus.handle }}, {{ bus.instance }}, {{ bus.pclk_symbol }}, &_{{ bus.handle }}_cfg);
    }
{% endfor %}
{% endif %}
{% if pwm_timers %}

    /* ---- Timer/PWM peripheral init ---- */
{% for t in pwm_timers %}
    {{ t.clk_func }}({{ t.clk_mask }});
    hal_timer_pwm_init(&{{ t.handle }}, {{ t.instance }}, SYSCLK_HZ, {{ t.freq }});
    hal_timer_pwm_start(&{{ t.handle }});
{% endfor %}
{% endif %}
{% if adc_config %}

    /* ---- ADC peripheral init ---- */
    tal_adc_init(&{{ adc_config.handle }}, {{ adc_config.resolution }});
{% for p in adc_config.pads %}
    tal_adc_add_pad(&{{ adc_config.handle }}, {{ p.pad }}, {{ adc_config.sampling }});
{% endfor %}
{% endif %}
}

{% if usb_capable and led %}
/* SOS on the onboard LED for the brick-recovery path, then return so the caller
 * jumps to ROM DFU. Runs pre-clock on the reset MSI clock (~4 MHz), so timing is
 * a rough busy-loop — exactness doesn't matter for a distress blink. */
__attribute__((unused))
static void core_recovery_sos(void)
{
    ll_rcc_gpio_clk_enable(LED_PORT);
    ll_gpio_set_mode(LED_PORT, LED_PIN, LL_GPIO_MODE_OUTPUT);
    /* One rapid SOS, then the caller jumps to the bootloader — recovery
     * shouldn't wait on the blink. ~25k busy-loops ≈ a ~30 ms dot on the
     * ~4 MHz reset clock, so the whole pattern runs in under ~1 s. */
    static const unsigned char sos[] = { 1, 1, 1, 3, 3, 3, 1, 1, 1 }; /* · · · — — — · · · */
    for (unsigned i = 0; i < sizeof(sos); i++) {
        LED_ON();
        for (volatile uint32_t d = 0; d < sos[i] * 25000UL; d++) { __asm volatile(""); }
        LED_OFF();
        for (volatile uint32_t d = 0; d < 25000UL; d++) { __asm volatile(""); }
    }
}
{% endif %}

void core_init(void)
{
{% if usb_capable %}
#ifdef ROM_DFU
    /* ROM DFU: check for magic before ANY peripheral/clock init.
     * If found, jump to the factory ROM bootloader (DfuSe, 0483:DF11).
     * The MCU is in near-reset state here — only .data/.bss init has run. */
    if (DFU_MAGIC_ADDR == DFU_MAGIC) {
        DFU_MAGIC_ADDR = 0;
        hal_dfu_jump_to_rom();  /* does not return */
    }
    /* Brick recovery: after CORE_RECOVERY_STRIKE_LIMIT consecutive watchdog
     * resets that never reached healthy operation, stop launching the (bad) app
     * — blink SOS and drop to the ROM bootloader so it can always be reflashed.
     * Pre-clock, like the magic check above. */
    if (core_recovery_over_limit(core_recovery_note_boot())) {
        /* The IWDG survives a warm/system reset on this MCU (only a power-on
         * reset stops it) and the ROM bootloader never feeds it — so a 5 s dog
         * would reset the bootloader out from under a reflash every timeout,
         * leaving the DFU "park" too short to catch. Stretch it to ~the max
         * (~30 s) so each park is a wide, grabbable window; strikes are retained
         * across the reset, so it re-parks in DFU rather than relaunching the
         * bad app. The IWDG can't be stopped in software, so max reload is the
         * best we can do. */
        core_watchdog_start(30000);
{% if led %}
        core_recovery_sos();
{% endif %}
        hal_dfu_jump_to_rom();  /* does not return */
    }
#endif
{% endif %}
#ifdef APP_OFFSET
    /* Relocate vector table for bootloader builds (app not at 0x08000000) */
    REG32(0xE000ED08UL) = APP_OFFSET;
#endif

{% if ble_contract or ble_radio %}
    /* Radio settings (TX power, advertising interval, pairing) must be applied
     * before core_ble_init(); the generated GATT builder must be registered
     * before it too. The builder itself runs later, inside core_ble_init(). */
    ble_contract_configure();
{% if ble_contract %}
    core_ble_set_services(ble_contract_build);
{% endif %}
{% endif %}
    core_clock_init();
    core_pads_init();
{% if usb_capable %}

    /* ---- USB CDC (always-on for DFU recovery) ----
     * Ensures the 1200-baud touch mechanism works even when main.c
     * doesn't call core_usb_init() — prevents DFU lockout. */
    hal_usb_cdc_init();
{% endif %}
{% if iwdg_enabled %}

    /* ---- Watchdog on by default ----
     * The app (starter template) must call core_watchdog_feed() in its loop.
     * Un-fed code trips a reset; after CORE_RECOVERY_STRIKE_LIMIT of them the
     * strike counter escalates to ROM DFU (the ROM_DFU block above). Frozen
     * while halted under SWD so a breakpoint doesn't false-trip the reset. */
    core_watchdog_debug_freeze();
    core_watchdog_start({{ iwdg_timeout_ms }});
{% endif %}
}

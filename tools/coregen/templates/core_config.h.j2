/**
 * core_config.h — Project-specific configuration for {{ tile_name }}
 *
 * AUTO-GENERATED by coregen from {{ source_file }} + {{ config_file }}
 * Project: {{ project_name }}
 *
 * DO NOT EDIT — regenerate by rebuilding the project.
 */

#ifndef CORE_CONFIG_H
#define CORE_CONFIG_H

/* ---- Clock configuration ---- */

#define CLOCK_SOURCE_{{ clock_config.source | upper }}  1
#define SYSCLK_MHZ        {{ clock_config.sysclk_mhz }}
{% if clock_config.sysclk_hz is defined and clock_config.sysclk_hz != clock_config.sysclk_mhz * 1000000 %}
#define SYSCLK_HZ         {{ clock_config.sysclk_hz }}UL   /* MSI range: {{ "%.6f" | format(clock_config.sysclk_hz / 1000000) }} MHz exactly */
{% else %}
#define SYSCLK_HZ         ({{ clock_config.sysclk_mhz }}UL * 1000000UL)
{% endif %}

{% if clock_config.level is defined %}
#define CLOCK_LEVEL_{{ clock_config.level | upper }}   1
#define CLOCK_LEVEL_NAME   "{{ clock_config.level }}"
{% endif %}
{% if clock_config.vos_range %}
#define CLOCK_VOS_RANGE    {{ clock_config.vos_range }}   /* core voltage range core_clock_init() selects */
{% endif %}
{% if clock_config.hpre5 %}
#define CLOCK_HPRE5        {{ clock_config.hpre5 }}   /* hclk5 = SYSCLK / CLOCK_HPRE5 on the PLL */
{% endif %}

{% if clock_config.pll %}
#define CLOCK_USE_PLL      1
#define PLL_M              {{ clock_config.pll.m }}
#define PLL_N              {{ clock_config.pll.n }}
#define PLL_R              {{ clock_config.pll.r }}
{% else %}
#define CLOCK_USE_PLL      0
{% endif %}

#define AHB_DIV            {{ clock_config.ahb_div }}
#define APB1_DIV           {{ clock_config.apb1_div }}
#define APB2_DIV           {{ clock_config.apb2_div }}

#define HCLK_HZ           (SYSCLK_HZ / AHB_DIV)
#define PCLK1_HZ          (HCLK_HZ / APB1_DIV)
#define PCLK2_HZ          (HCLK_HZ / APB2_DIV)

{% if i2c_kernel_clk_mhz is defined and i2c_kernel_clk_mhz %}
#define I2C_KERNEL_CLK_MHZ  {{ i2c_kernel_clk_mhz }}
{% else %}
#define I2C_KERNEL_CLK_MHZ  SYSCLK_MHZ
{% endif %}

{% if pad_config %}
/* ---- Pad assignments ---- */
/*
 * Each assigned pad gets:
 *   PIN_PAD<n>_FUNC    — the assigned function name
 *   PIN_PAD<n>_MODE    — "output", "input", or "af"
 *   PIN_PAD<n>_AF      — AF number (only for mode "af")
 */

{% for pin in pad_config %}
/* Pad {{ pin.pad }}: P{{ pin.port }}{{ pin.pin }} → {{ pin.function }} */
#define PIN_PAD{{ pin.pad }}_FUNC     "{{ pin.function }}"
{% if pin.mode == "output" %}
#define PIN_PAD{{ pin.pad }}_MODE     1  /* GPIO output */
{% elif pin.mode == "input" %}
#define PIN_PAD{{ pin.pad }}_MODE     0  /* GPIO input */
{% else %}
#define PIN_PAD{{ pin.pad }}_MODE     2  /* alternate function */
#define PIN_PAD{{ pin.pad }}_AF       {{ pin.af }}
{% endif %}
{% endfor %}
{% endif %}

{% if iface_config %}
/* ---- Interface configuration ---- */

{% for name, params in iface_config.items() %}
/* {{ name }} */
{% if params.get("speed") is not none %}
#define {{ name }}_SPEED_HZ    {{ params.speed }}
{% endif %}
{% if params.get("baud") is not none %}
#define {{ name }}_BAUD        {{ params.baud }}
{% endif %}
{% if params.get("mode") is not none %}
#define {{ name }}_MODE_{{ params.mode | upper }}  1
{% endif %}
{% if params.get("word_length") is not none %}
#define {{ name }}_WORD_LEN    {{ params.word_length }}
{% endif %}
{% if params.get("stop_bits") is not none %}
#define {{ name }}_STOP_BITS   {{ params.stop_bits }}
{% endif %}
{% if params.get("parity") is not none %}
#define {{ name }}_PARITY_{{ params.parity | upper }}  1
{% endif %}
{% endfor %}
{% endif %}

{% if usb_vid is not none or usb_pid is not none or usb_product or usb_manufacturer or usb_serial %}
/* ---- USB identity ---- */
/* Per-project overrides for the CDC/HID descriptors (config.json "usb").
 * Unset fields fall back to the SDK defaults in hal_usb_cdc.c. CMSIS-DAP
 * hosts auto-detect by matching "CMSIS-DAP" in the product string. */
{% if usb_vid is not none %}
#define CORE_USB_VID          0x{{ '%04X' | format(usb_vid) }}
{% endif %}
{% if usb_pid is not none %}
#define CORE_USB_PID          0x{{ '%04X' | format(usb_pid) }}
{% endif %}
{% if usb_product %}
#define CORE_USB_PRODUCT      "{{ usb_product }}"
{% endif %}
{% if usb_manufacturer %}
#define CORE_USB_MANUFACTURER "{{ usb_manufacturer }}"
{% endif %}
{% if usb_serial %}
#define CORE_USB_SERIAL       "{{ usb_serial }}"
{% endif %}
{% endif %}

{% if bootloader_mode != "none" %}
/* ---- Bootloader ---- */
/*   "custom" — Core DFU bootloader (1209:0002). App at 0x08002000.
 *   "rom"    — ST ROM bootloader (0483:DF11). App at 0x08000000.
 * Configured in config.json: "bootloader": "{{ bootloader_mode }}" */
#define BOOTLOADER_MODE  "{{ bootloader_mode }}"
{% endif %}

#endif /* CORE_CONFIG_H */

    {
      "name": "core_rtc_set_alarm",
      "signature": "core_rtc_set_alarm(uint8_t hours, uint8_t minutes, uint8_t seconds)",
      "returns": "void",
      "brief": "Set Alarm A to trigger at a specific time. Pass 0xFF for hours, minutes, or seconds to ignore that field. The alarm fires when all non-masked fields match the RTC time.",
      "params": [
        {
          "name": "hours",
          "ctype": "uint8_t",
          "range": [
            0,
            255
          ],
          "description": "0-23, or 255 (0xFF) to match any hour."
        },
        {
          "name": "minutes",
          "ctype": "uint8_t",
          "range": [
            0,
            255
          ],
          "description": "0-59, or 255 (0xFF) to match any minute."
        },
        {
          "name": "seconds",
          "ctype": "uint8_t",
          "range": [
            0,
            255
          ],
          "description": "0-59, or 255 (0xFF) to match any second."
        }
      ],
      "studio_exposed": true,
      "layer": "core"
    },

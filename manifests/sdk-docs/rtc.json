    {
      "name": "core_rtc_init",
      "signature": "core_rtc_init(void)",
      "returns": "void",
      "brief": "Initialize the RTC using LSI (internal RC, ~32 kHz; ~37 kHz on Core.ST.L0, scaled so a second is still ~1 s). Call once from `on start` before setting time, date, or alarms. For LSE, call ll_rtc_init(1) directly in hand-written C (Core.ST.L0 has no LSE and stays on LSI).",
      "params": [],
      "studio_exposed": true,
      "layer": "core"
    },

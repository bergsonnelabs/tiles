# Build artifacts
build/
generated/
__pycache__/
*.pyc
.DS_Store

# Coregen output (regenerated on build)
**/coregen/
# …but not the generator itself, which lives at tools/coregen/.
!tools/coregen/
!tools/coregen/**
tests/**/core.h
examples/**/core.h
templates/**/core.h
factory/**/core.h

# Generated tile handles (regenerated on build)
**/tile_handles.h

# User project directory — not tracked
projects/
!projects/.gitkeep

# Claude Code
.claude/

# Factory image build stamp (written by its Makefile)
factory/**/build_info.h
